# Strava API app credentials — create one at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=replace-with-strava-client-id
STRAVA_CLIENT_SECRET=replace-with-strava-client-secret
# Any string; Strava echoes it back on webhook subscription validation.
STRAVA_WEBHOOK_VERIFY_TOKEN=replace-with-any-random-string

# Signs the app's own session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32

# Comma-separated Strava athlete IDs granted the admin role on login (custom
# sports and metrics). Optional; removing an ID stops re-granting but never demotes.
ADMIN_STRAVA_ATHLETE_IDS=

# Public URLs for the two services. FRONTEND_URL/PUBLIC_BASE_URL must be real,
# internet-reachable HTTPS URLs in production — Strava calls PUBLIC_BASE_URL
# directly for webhooks, and PUBLIC_BASE_URL/auth/strava/callback must be
# registered as the Authorization Callback Domain in the Strava API app settings.
FRONTEND_URL=https://app.fitter.example
PUBLIC_BASE_URL=https://api.fitter.example

# Only used with the Caddy overlay (docker-compose.caddy.yml) — bare hostnames
# (no scheme), matching FRONTEND_URL/PUBLIC_BASE_URL above.
CADDY_FRONTEND_HOST=app.fitter.example
CADDY_BACKEND_HOST=api.fitter.example
